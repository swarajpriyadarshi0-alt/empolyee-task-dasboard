<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Northstar | Work management</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
    :root { --ink:#17212b; --muted:#687684; --line:#e7ecef; --paper:#f6f8f9; --white:#fff; --teal:#007c78; --teal-dark:#00625f; --mint:#dff4ef; --amber:#f6b846; --red:#d85656; --navy:#153342; --shadow:0 12px 35px rgba(23,33,43,.08); }
    * { box-sizing:border-box; } body { margin:0; color:var(--ink); background:var(--paper); font:14px 'DM Sans', sans-serif; } button,input,select,textarea { font:inherit; } button { cursor:pointer; border:0; } .hidden { display:none!important; }
    .login-shell { min-height:100vh; display:grid; grid-template-columns:1.05fr .95fr; background:#f3f7f6; } .login-art { padding:10vh 10%; background:var(--navy); color:white; position:relative; overflow:hidden; } .login-art:after { content:''; position:absolute; width:460px; height:460px; border:1px solid rgba(255,255,255,.15); border-radius:50%; right:-180px; bottom:-150px; box-shadow:0 0 0 55px rgba(255,255,255,.04),0 0 0 110px rgba(255,255,255,.03); } .brand { font-family:'Space Grotesk'; font-size:21px; font-weight:700; letter-spacing:-.5px; display:flex; gap:10px; align-items:center; } .brand-mark { width:31px; height:31px; background:#54d3b7; color:var(--navy); display:grid; place-items:center; border-radius:9px; font-weight:800; } .login-art h1 { font:600 clamp(42px,5vw,74px)/.98 'Space Grotesk'; max-width:600px; letter-spacing:-3px; margin:22vh 0 22px; } .login-art p { color:#bbd0d3; max-width:380px; line-height:1.7; font-size:16px; } .login-box { width:min(420px,calc(100% - 48px)); margin:auto; } .login-box h2 { font:600 31px 'Space Grotesk'; margin:0 0 8px; letter-spacing:-1.3px; } .eyebrow { color:var(--teal); font-weight:700; letter-spacing:1px; text-transform:uppercase; font-size:11px; } .login-box .sub { color:var(--muted); margin:0 0 33px; } label { display:block; font-weight:600; font-size:12px; margin:18px 0 7px; color:#43505b; } input,select,textarea { width:100%; border:1px solid #dbe3e6; border-radius:8px; padding:12px 13px; color:var(--ink); background:#fff; outline:none; transition:.2s; } input:focus,select:focus,textarea:focus { border-color:var(--teal); box-shadow:0 0 0 3px rgba(0,124,120,.12); } textarea { resize:vertical; min-height:86px; } .primary { background:var(--teal); color:#fff; border-radius:8px; padding:12px 17px; font-weight:700; } .primary:hover { background:var(--teal-dark); } .wide { width:100%; margin-top:24px; } .login-help { background:#edf7f4; color:#376760; border-radius:8px; padding:12px; font-size:12px; line-height:1.55; margin-top:26px; } .login-error { min-height:20px; color:var(--red); margin-top:14px; font-size:13px; }
    .app { min-height:100vh; display:flex; } .sidebar { width:235px; background:#fff; border-right:1px solid var(--line); padding:25px 16px; display:flex; flex-direction:column; flex-shrink:0; } .sidebar .brand { margin:0 11px 58px; } .nav-label { color:#9aa6ad; text-transform:uppercase; letter-spacing:1.2px; font-size:10px; font-weight:700; padding:0 12px; margin-bottom:10px; } .nav-btn { width:100%; display:flex; align-items:center; gap:12px; padding:11px 12px; background:transparent; border-radius:8px; text-align:left; color:#72808a; margin-bottom:4px; font-weight:600; } .nav-btn.active,.nav-btn:hover { background:#edf8f5; color:var(--teal); } .nav-icon { width:18px; text-align:center; font-size:16px; } .sidebar-foot { margin-top:auto; border-top:1px solid var(--line); padding:17px 10px 0; color:var(--muted); font-size:12px; } .profile { display:flex; gap:10px; align-items:center; margin-bottom:15px; } .avatar { width:35px; height:35px; border-radius:50%; background:#d6efea; color:var(--teal-dark); display:grid; place-items:center; font-weight:700; } .profile strong { display:block; color:var(--ink); font-size:13px; } .profile span { font-size:11px; } .logout { background:none; padding:0; color:var(--red); font-size:12px; }
    .stat-button { width:100%; color:inherit; text-align:left; font:inherit; cursor:pointer; transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease; } .stat-button:hover,.stat-button:focus-visible { transform:translateY(-3px); border-color:#9ed5cc; box-shadow:0 10px 22px rgba(0,124,120,.12); outline:none; } .stat-button:active { transform:translateY(-1px); } .detail-modal { width:min(900px,100%); } .detail-modal .modal-table { max-height:55vh; overflow:auto; border:1px solid var(--line); border-radius:8px; } .detail-modal table { min-width:620px; } .detail-modal .toolbar { border-radius:8px; border:1px solid var(--line); margin-bottom:12px; } .detail-modal .toolbar input { max-width:none; } .detail-empty { color:var(--muted); text-align:center; padding:35px 15px; }
    .modal-backdrop { position:fixed; inset:0; background:rgba(21,51,66,.42); display:grid; place-items:center; padding:20px; z-index:10; } .modal { background:#fff; width:min(560px,100%); max-height:90vh; overflow:auto; border-radius:12px; padding:25px; box-shadow:0 25px 70px rgba(0,0,0,.2); } .modal h2 { margin:0; font:600 21px 'Space Grotesk'; } .modal-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; } .close { background:none; color:var(--muted); font-size:22px; } .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 14px; } .full { grid-column:1/-1; } .form-actions { display:flex; justify-content:flex-end; gap:9px; margin-top:23px; } .secondary { padding:11px 16px; border-radius:8px; background:#edf1f2; color:#52616a; font-weight:700; } .toast { position:fixed; right:22px; bottom:22px; z-index:20; background:#173f47; color:white; padding:13px 17px; border-radius:8px; box-shadow:var(--shadow); } .mobile-menu { display:none; }
    .performance { margin-top:30px; } .performance-grid { display:grid; grid-template-columns:1.2fr 1fr; gap:18px; } .chart-panel { background:#fff; border:1px solid var(--line); border-radius:10px; padding:20px; min-width:0; } .chart-panel h3 { margin:0 0 5px; font:600 16px 'Space Grotesk'; } .chart-panel p { color:var(--muted); font-size:12px; margin:0 0 18px; } .summary-strip { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-bottom:18px; } .summary-item { background:#f7faf9; border-radius:8px; padding:13px; } .summary-item strong { display:block; font:600 22px 'Space Grotesk'; } .summary-item span { color:var(--muted); font-size:11px; } .bar-list { display:grid; gap:12px; } .bar-row { display:grid; grid-template-columns:minmax(100px,145px) 1fr 38px; align-items:center; gap:9px; font-size:11px; } .bar-label { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:#44545e; } .bar-track { height:10px; border-radius:10px; background:#edf2f2; overflow:hidden; } .bar-fill { height:100%; background:var(--teal); border-radius:10px; min-width:0; transition:width .35s ease; } .bar-value { color:var(--muted); text-align:right; font-weight:700; } .stack-row { display:grid; grid-template-columns:minmax(100px,145px) 1fr; align-items:center; gap:9px; font-size:11px; } .stack { display:flex; height:14px; border-radius:10px; overflow:hidden; background:#edf2f2; } .stack span { min-width:0; transition:width .35s ease; } .stack-pending { background:#f6c55b; } .stack-progress { background:#67a9d7; } .stack-completed { background:#58b99e; } .legend { display:flex; gap:12px; flex-wrap:wrap; margin-top:15px; color:var(--muted); font-size:11px; } .legend i { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; } .rate-list { display:grid; gap:12px; } .rate-row { display:grid; grid-template-columns:minmax(100px,145px) 1fr 40px; gap:9px; align-items:center; font-size:11px; } .rate-track { height:7px; border-radius:8px; background:#edf2f2; overflow:hidden; } .rate-fill { height:100%; background:#58b99e; border-radius:8px; } .empty-chart { color:var(--muted); padding:22px 0; text-align:center; font-size:12px; }
    @media (max-width:1000px) { .stats { grid-template-columns:repeat(3,1fr); } .two-col,.performance-grid { grid-template-columns:1fr; } }
    @media (max-width:700px) { .login-shell { display:block; } .login-art { min-height:245px; padding:28px 24px; } .login-art h1 { margin:48px 0 0; font-size:40px; } .login-art p { display:none; } .login-box { padding:45px 0; } .sidebar { position:fixed; z-index:5; left:-245px; top:0; bottom:0; transition:.25s; box-shadow:var(--shadow); } .sidebar.open { left:0; } .mobile-menu { display:block; background:none; font-size:21px; margin-right:10px; } .topbar { padding:0 18px; height:72px; } .page-title h1 { font-size:20px; } .page-title p { display:none; } .content { padding:23px 18px 40px; } .stats { grid-template-columns:repeat(2,1fr); gap:9px; margin-bottom:25px; } .stat { min-height:93px; padding:14px; } .stat-number { margin-top:13px; font-size:24px; } .stat:nth-child(5) { grid-column:1/-1; } .toolbar { flex-wrap:wrap; } .toolbar input { max-width:none; width:100%; } .toolbar select { flex:1; min-width:0; } .form-grid { display:block; } .summary-strip { grid-template-columns:repeat(2,1fr); } .bar-row,.stack-row,.rate-row { grid-template-columns:90px 1fr 35px; } }
    .overview-hero { display:flex; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:28px; padding:28px 30px; border:1px solid #dcebe8; border-radius:16px; background:linear-gradient(135deg,#ffffff 0%,#f0f8f6 100%); box-shadow:0 10px 28px rgba(23,33,43,.05); } .overview-kicker { color:var(--teal); font-size:11px; font-weight:700; letter-spacing:1.3px; text-transform:uppercase; margin-bottom:9px; } .overview-hero h1 { margin:0; font:600 clamp(27px,3vw,40px)/1.05 'Space Grotesk'; letter-spacing:-1.6px; } .overview-hero p { margin:9px 0 0; color:var(--muted); font-size:14px; } .overview-date { display:flex; align-items:center; gap:12px; color:var(--muted); font-size:12px; text-align:right; } .overview-date .avatar { width:44px; height:44px; font-size:14px; } .overview-date strong { display:block; color:var(--ink); font-size:13px; margin-bottom:3px; } .overview-date span { display:block; } .overview-section { animation:overview-in .35s ease both; } .overview-section:nth-of-type(2) { animation-delay:.05s; } .overview-section:nth-of-type(3) { animation-delay:.1s; } @keyframes overview-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } } #employeePicker { background:#fbfdfd; box-shadow:inset 0 1px 3px rgba(23,33,43,.03); } #employeePicker label { display:grid !important; grid-template-columns:18px 72px minmax(0,1fr); align-items:center; column-gap:9px; padding:9px 10px; margin:2px 0 !important; border-radius:7px; transition:background .15s ease; } #employeePicker label:hover { background:#edf8f5; } #employeePicker label input { width:16px; height:16px; margin:0; accent-color:var(--teal); } #employeePicker label span { display:contents; } #employeePicker label span::first-line { color:var(--muted); } #employeePicker + #selectedEmployees { padding-top:5px; border-top:1px solid var(--line); } #selectedEmployees .badge { background:#e8f5f1; color:var(--teal-dark); }
    .overview-section { margin-top:30px; } .overview-section .section-head { margin-bottom:14px; } .overview-section .section-head h2 { font-size:21px; } .stats { grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:0; } .stat { border-radius:14px; padding:19px; min-height:116px; } .stat-number { font-size:31px; letter-spacing:-1px; } .stat-button .stat-top:after { content:'View details'; opacity:0; color:var(--teal); font-size:10px; font-weight:700; transition:opacity .18s ease; } .stat-button:hover .stat-top:after,.stat-button:focus-visible .stat-top:after { opacity:1; } .stat-button:nth-child(4) .stat-icon,.stat-button:nth-child(5) .stat-icon { background:#e6f0fa; color:#3976a4; } .stat-button:nth-child(6) .stat-icon { background:#e2f5ed; color:#258269; } .stat-button:nth-child(7) .stat-icon { background:#fff0d3; color:#aa7405; } .stat-button:nth-child(8) .stat-icon { background:#fbe3e3; color:var(--red); }
    .overview-analytics { display:grid; grid-template-columns:1.4fr 1fr; gap:18px; } .overview-analytics .chart-panel { border-radius:14px; padding:22px; box-shadow:0 7px 22px rgba(23,33,43,.04); } .overview-analytics .chart-panel h3 { font-size:17px; } .activity-panel { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-top:18px; } .activity-list { display:grid; gap:12px; } .activity-item { display:grid; grid-template-columns:32px 1fr auto; gap:10px; align-items:start; padding-bottom:12px; border-bottom:1px solid #eef2f2; } .activity-item:last-child { border-bottom:0; padding-bottom:0; } .activity-icon { width:30px; height:30px; display:grid; place-items:center; border-radius:9px; background:#e4f4ef; color:var(--teal); font-weight:700; } .activity-item strong { display:block; font-size:12px; } .activity-item p { margin:3px 0 0; color:var(--muted); font-size:11px; line-height:1.4; } .activity-item time { color:#9ba7ac; font-size:10px; white-space:nowrap; } .loading-panel { min-height:180px; display:grid; place-items:center; color:var(--muted); } .loading-dot { display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--teal); margin-right:8px; animation:pulse 1s ease-in-out infinite; } @keyframes pulse { 0%,100%{opacity:.25;transform:scale(.8)} 50%{opacity:1;transform:scale(1)} }
    @media (max-width:1000px) { .stats { grid-template-columns:repeat(3,1fr); } .overview-analytics,.activity-panel { grid-template-columns:1fr; } }
    @media (max-width:700px) { .overview-hero { align-items:flex-start; flex-direction:column; padding:22px; } .overview-date { text-align:left; } .stats { grid-template-columns:repeat(2,1fr); } .stat { min-height:105px; padding:15px; } .stat-number { font-size:26px; } .stat-button .stat-top:after { display:none; } }
  </style>
</head>
<body>
  <section id="loginView" class="login-shell">
    <div class="login-art"><div class="brand"><span class="brand-mark">N</span> NORTHSTAR</div><h1>Make work move forward.</h1><p>A calm, clear home for every assignment, deadline, and win across your team.</p></div>
    <div class="login-box"><div class="eyebrow">Workspace sign in</div><h2>Welcome back</h2><p class="sub">Sign in to your Northstar workspace.</p><form id="loginForm"><label for="loginId">User ID</label><input id="loginId" autocomplete="username" placeholder="e.g. admin or EMP001" required><label for="loginPassword">Password</label><input id="loginPassword" type="password" autocomplete="current-password" placeholder="Enter your password" required><button class="primary wide" type="submit">Sign in to workspace</button><div id="loginError" class="login-error"></div></form><div class="login-help"><strong>Demo access</strong><br>Admin: admin / admin123 &nbsp; · &nbsp; Employee: EMP001 / employee123</div></div>
  </section>
  <section id="appView" class="app hidden">
    <aside id="sidebar" class="sidebar"><div class="brand"><span class="brand-mark">N</span> NORTHSTAR</div><div class="nav-label">Workspace</div><button class="nav-btn active" data-page="overview"><span class="nav-icon">⌂</span> Overview</button><button class="nav-btn admin-only" data-page="tasks"><span class="nav-icon">✓</span> Task management</button><button class="nav-btn admin-only" data-page="employees"><span class="nav-icon">♧</span> Employees</button><button class="nav-btn employee-only" data-page="mytasks"><span class="nav-icon">✓</span> My tasks</button><div class="sidebar-foot"><div class="profile"><div id="userAvatar" class="avatar">O</div><div><strong id="userName">User</strong><span id="userRole">Workspace member</span></div></div><button id="logoutBtn" class="logout" type="button">Logout</button></div></aside>
    <main class="main"><header class="topbar"><div class="page-title"><button id="menuBtn" class="mobile-menu">☰</button><h1 id="pageHeading">Good morning, Ankit</h1><p id="pageSubheading">Here is what is happening across your workspace.</p></div><div class="top-actions"><button id="notificationBtn" class="icon-btn" title="Notifications">♢<span id="notificationDot" class="notification-dot hidden"></span></button><button id="accountBtn" class="icon-btn" title="Change password">⚙</button></div></header><div id="content" class="content"></div></main>
  </section>
  <div id="modalRoot"></div><div id="toast" class="toast hidden"></div>
  <script>
    const PRIORITIES = ['Low','Medium','High','Urgent'];
    const STATUSES = ['Not Started','In Progress','Completed','On Hold','Pending Review'];
    const state = { user:null, users:[], branches:[], tasks:[], notifications:[], history:[], page:'overview', query:'', status:'all', priority:'all' };
    const $ = id => document.getElementById(id);
    const api = async (url, options={}) => { const response = await fetch(url, { headers:{'Content-Type':'application/json'}, ...options }); const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Something went wrong.'); return data; };
    const initials = name => (name || 'U').split(' ').map(part => part[0]).slice(0,2).join('').toUpperCase();
    const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    const isOverdue = task => task.status !== 'Completed' && task.dueDate < new Date().toISOString().slice(0,10);
    const statusClass = status => status === 'In Progress' ? 'status-progress' : status === 'Completed' ? 'status-completed' : 'status-pending';
    const priorityClass = priority => `priority-${String(priority).toLowerCase()}`;
    const formatDate = value => value ? new Date(`${value}T00:00:00`).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}) : '—';
    const formatTime = value => new Date(value).toLocaleDateString(undefined,{month:'short',day:'numeric'});
    function toast(message) { $('toast').textContent = message; $('toast').classList.remove('hidden'); setTimeout(() => $('toast').classList.add('hidden'), 3000); }
    function stats(tasks, employees=state.users) { return { employees:employees.length, active:employees.filter(u=>u.active).length, total:tasks.length, pending:tasks.filter(t=>['Not Started','Pending','Pending Review','On Hold'].includes(t.status)).length, progress:tasks.filter(t=>t.status==='In Progress').length, completed:tasks.filter(t=>t.status==='Completed').length, overdue:tasks.filter(isOverdue).length }; }
    async function refresh() { const data = await api('/api/dashboard'); Object.assign(state,data); $('userName').textContent=state.user.name; $('userRole').textContent=state.user.role==='admin'?'Admin / Manager':'Employee'; $('userAvatar').textContent=initials(state.user.name); $('notificationDot').classList.toggle('hidden',!state.notifications.some(n=>!n.read)); render(); }
    function showApp() { $('loginView').classList.add('hidden'); $('appView').classList.remove('hidden'); if (!document.querySelector('[data-page="branches"]')) { const button=document.createElement('button'); button.className='nav-btn admin-only'; button.dataset.page='branches'; button.innerHTML='<span class="nav-icon">⌖</span> Branches'; document.querySelector('[data-page="employees"]').after(button); } }
    function render() { const admin=state.user.role==='admin'; document.querySelectorAll('.admin-only').forEach(el=>el.classList.toggle('hidden',!admin)); document.querySelectorAll('.employee-only').forEach(el=>el.classList.toggle('hidden',admin)); document.querySelectorAll('.nav-btn').forEach(el=>el.classList.toggle('active',el.dataset.page===state.page)); if (state.page==='employees' && admin) renderEmployees(); else if (state.page==='tasks' && admin) renderTasks(); else if (state.page==='mytasks' && !admin) renderMyTasks(); else renderOverview(); }
    function heading(title, sub) { $('pageHeading').textContent=title; $('pageSubheading').textContent=sub; }
    function statCard(label, value, icon, extra='', metric='') { const key=metric||({'Total employees':'employees','Active employees':'activeEmployees','Total branches':'branches','Total tasks':'tasks','Completed':'completed','In progress':'inProgress','Pending':'pending','Overdue':'overdue','Overall progress':'progress','Assigned tasks':'tasks'}[label]||label.toLowerCase().replace(/\s+/g,'-')); return `<button type="button" class="stat stat-button ${extra}" data-action="overview-detail" data-metric="${key}" aria-label="View ${label} details"><span class="stat-top"><span>${label}</span><span class="stat-icon">${icon}</span></span><span class="stat-number">${value}</span></button>`; }
    function renderOverview() { const s=stats(state.tasks); heading(`Good morning, ${state.user.name.split(' ')[0]}`,state.user.role==='admin'?'Here is what is happening across your workspace.':'Here is your task pulse for today.'); const cards=state.user.role==='admin'?[statCard('Total employees',s.employees,'♧'),statCard('Active employees',s.active,'●'),statCard('Total tasks',s.total,'✓'),statCard('In progress',s.progress,'↗'),statCard('Overdue',s.overdue,'!','danger')]:[statCard('Assigned tasks',s.total,'✓'),statCard('Pending',s.pending,'○','warn'),statCard('In progress',s.progress,'↗'),statCard('Completed',s.completed,'●'),statCard('Overdue',s.overdue,'!','danger')]; $('content').innerHTML=`<div class="stats">${cards.join('')}</div><div class="two-col"><section><div class="section-head"><div><h2>${state.user.role==='admin'?'Recent task activity':'Your task list'}</h2><p>${state.user.role==='admin'?'A live view of work across the team.':'Keep your assignments moving.'}</p></div>${state.user.role==='admin'?'<button class="primary" data-action="new-task">＋ Create task</button>':''}</div><div class="task-list">${taskCards(state.tasks.slice(0,5))}</div></section><section class="panel"><div class="section-head"><div><h2>Notifications</h2><p>Updates from your workspace</p></div></div><div class="notice-list">${notifications()}</div></section></div>`; }
    function taskCards(tasks) { if(!tasks.length) return '<div class="panel empty">No tasks to show yet.</div>'; return tasks.map(task=>`<article class="task-card"><div class="task-card-top"><div><h3>${esc(task.title)}</h3><p>${esc(task.description)||'No description added.'}</p></div><span class="badge ${statusClass(task.status)}">${esc(task.status)}</span></div><div class="task-meta"><span>Due ${formatDate(task.dueDate)}</span><span class="badge ${priorityClass(task.priority)}">${esc(task.priority)}</span>${state.user.role==='admin'?`<span>${esc(task.assigneeName)}</span>`:''}<button class="small-btn" data-action="edit-task" data-id="${task.id}">View</button></div></article>`).join(''); }
    function notifications() { if(!state.notifications.length) return '<div class="empty">You are all caught up.</div>'; return state.notifications.slice(0,5).map(n=>`<div class="notice ${n.read?'':'unread'}"><div class="notice-mark">${n.type==='completed'?'✓':'!'}</div><div><strong>${esc(n.title)}</strong><p>${esc(n.body)}</p><time>${formatTime(n.createdAt)}</time></div></div>`).join(''); }
    function toolbar() { return `<div class="toolbar"><input id="search" placeholder="Search tasks..." value="${esc(state.query)}"><select id="filterStatus"><option value="all">All statuses</option><option>Pending</option><option>In Progress</option><option>Completed</option></select><select id="filterPriority"><option value="all">All priorities</option><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select></div>`; }
    function filteredTasks() { return state.tasks.filter(t=>(!state.query||`${t.title} ${t.description} ${t.assigneeName}`.toLowerCase().includes(state.query.toLowerCase()))&&(state.status==='all'||t.status===state.status)&&(state.priority==='all'||t.priority===state.priority)); }
    function renderTasks() { heading('Task management','Create, assign, and monitor every piece of work.'); $('content').innerHTML=`<div class="section-head"><div><h2>All tasks</h2><p>${state.tasks.length} tasks in this workspace</p></div><button class="primary" data-action="new-task">＋ Create task</button></div>${toolbar()}<div class="table-wrap"><table><thead><tr><th>Task</th><th>Assignee</th><th>Priority</th><th>Due date</th><th>Status</th><th></th></tr></thead><tbody>${filteredTasks().map(task=>`<tr><td><strong>${esc(task.title)}</strong><small style="display:block;color:#87949b;margin-top:4px">${esc(task.description).slice(0,55)}</small></td><td>${esc(task.assigneeName)}</td><td><span class="badge ${priorityClass(task.priority)}">${esc(task.priority)}</span></td><td>${formatDate(task.dueDate)}</td><td><span class="badge ${isOverdue(task)?'status-overdue':statusClass(task.status)}">${isOverdue(task)?'Overdue':esc(task.status)}</span></td><td class="row-actions"><button class="small-btn" data-action="edit-task" data-id="${task.id}">Edit</button><button class="small-btn delete" data-action="delete-task" data-id="${task.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No matching tasks.</td></tr>'}</tbody></table></div>`; $('filterStatus').value=state.status; $('filterPriority').value=state.priority; }
    function renderEmployees() { heading('Employees','Manage access and see who is carrying the work.'); $('content').innerHTML=`<div class="section-head"><div><h2>People</h2><p>${state.users.length} employee accounts</p></div><button class="primary" data-action="new-employee">＋ Add employee</button></div><div class="toolbar"><input id="employeeSearch" placeholder="Search employees..."></div><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Department</th><th>Access</th><th>Tasks</th><th>Joined</th><th></th></tr></thead><tbody>${state.users.map(u=>`<tr data-person="${esc(`${u.name} ${u.userId}`).toLowerCase()}"><td><div class="person"><div class="avatar">${initials(u.name)}</div><div><strong>${esc(u.name)}</strong><small>${esc(u.userId)}</small></div></div></td><td>${esc(u.department)}</td><td><span class="badge ${u.active?'status-completed':'status-overdue'}">${u.active?'Active':'Inactive'}</span></td><td>${state.tasks.filter(t=>t.assigneeId===u.id).length}</td><td>${formatDate(u.createdAt.slice(0,10))}</td><td class="row-actions"><button class="small-btn" data-action="edit-employee" data-id="${u.id}">Edit</button><button class="small-btn" data-action="toggle-employee" data-id="${u.id}">${u.active?'Deactivate':'Activate'}</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No employees yet.</td></tr>'}</tbody></table></div>`; $('employeeSearch').addEventListener('input',e=>document.querySelectorAll('[data-person]').forEach(row=>row.classList.toggle('hidden',!row.dataset.person.includes(e.target.value.toLowerCase())))); }
    function renderMyTasks() { heading('My tasks','Your assigned work, all in one place.'); $('content').innerHTML=`<div class="section-head"><div><h2>My task list</h2><p>Update a status as work progresses.</p></div></div>${toolbar()}<div class="task-list">${taskCards(filteredTasks())}</div>`; $('filterStatus').value=state.status; $('filterPriority').value=state.priority; }
    function openModal(title, body) { $('modalRoot').innerHTML=`<div class="modal-backdrop"><div class="modal"><div class="modal-head"><h2>${title}</h2><button class="close" data-action="close-modal">×</button></div>${body}</div></div>`; }
    function employeeModal(employee={}) { openModal(employee.id?'Edit employee':'Add employee',`<form id="employeeForm"><div class="form-grid"><div class="full"><label>Name</label><input name="name" value="${esc(employee.name)}" required></div><div><label>User ID</label><input name="userId" value="${esc(employee.userId)}" ${employee.id?'disabled':''} required></div><div><label>Department</label><input name="department" value="${esc(employee.department||'General')}"></div><div class="full"><label>${employee.id?'Reset password (optional)':'Password'}</label><input name="password" type="password" minlength="8" ${employee.id?'':'required'} placeholder="At least 8 characters"></div></div><div class="form-actions"><button type="button" class="secondary" data-action="close-modal">Cancel</button><button class="primary">${employee.id?'Save changes':'Create employee'}</button></div></form>`); $('employeeForm').onsubmit=async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));try{await api(employee.id?`/api/users/${employee.id}`:'/api/users',{method:employee.id?'PATCH':'POST',body:JSON.stringify(data)});$('modalRoot').innerHTML='';toast(employee.id?'Employee updated':'Employee created');await refresh();}catch(error){toast(error.message);}}; }
    function taskModal(task={}) { openModal(task.id?'Edit task':'Create task',`<form id="taskForm"><div class="form-grid"><div class="full"><label>Task title</label><input name="title" value="${esc(task.title)}" required></div><div class="full"><label>Description</label><textarea name="description" placeholder="What needs to be done?">${esc(task.description)}</textarea></div><div><label>Assign to</label><select name="assigneeId" required>${state.users.map(u=>`<option value="${u.id}" ${u.id===task.assigneeId?'selected':''}>${esc(u.name)}</option>`).join('')}</select></div><div><label>Priority</label><select name="priority"><option ${task.priority==='Low'?'selected':''}>Low</option><option ${!task.priority||task.priority==='Medium'?'selected':''}>Medium</option><option ${task.priority==='High'?'selected':''}>High</option><option ${task.priority==='Urgent'?'selected':''}>Urgent</option></select></div><div><label>Due date</label><input name="dueDate" type="date" value="${task.dueDate||''}" required></div><div><label>Status</label><select name="status"><option ${!task.status||task.status==='Pending'?'selected':''}>Pending</option><option ${task.status==='In Progress'?'selected':''}>In Progress</option><option ${task.status==='Completed'?'selected':''}>Completed</option></select></div></div><div class="form-actions"><button type="button" class="secondary" data-action="close-modal">Cancel</button><button class="primary">${task.id?'Save task':'Assign task'}</button></div></form>`); $('taskForm').onsubmit=async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));try{await api(task.id?`/api/tasks/${task.id}`:'/api/tasks',{method:task.id?'PATCH':'POST',body:JSON.stringify(data)});$('modalRoot').innerHTML='';toast(task.id?'Task updated':'Task assigned');await refresh();}catch(error){toast(error.message);}}; }
    function passwordModal() { openModal('Change password','<form id="passwordForm"><label>New password</label><input name="password" type="password" minlength="8" placeholder="At least 8 characters" required><div class="form-actions"><button type="button" class="secondary" data-action="close-modal">Cancel</button><button class="primary">Update password</button></div></form>'); $('passwordForm').onsubmit=async e=>{e.preventDefault();try{await api('/api/account/password',{method:'PATCH',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});$('modalRoot').innerHTML='';toast('Password updated');}catch(error){toast(error.message);}}; }
    function branchModal(branch={}) { openModal(branch.id?'Edit branch':'Add branch',`<form id="branchForm"><label>Branch name</label><input name="name" value="${esc(branch.name)}" required><div class="form-actions"><button type="button" class="secondary" data-action="close-modal">Cancel</button><button class="primary">${branch.id?'Save branch':'Add branch'}</button></div></form>`); $('branchForm').onsubmit=async e=>{e.preventDefault();try{await api(branch.id?`/api/branches/${branch.id}`:'/api/branches',{method:branch.id?'PATCH':'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});$('modalRoot').innerHTML='';toast(branch.id?'Branch updated':'Branch added successfully.');await refresh();}catch(error){toast(error.message);}}; }
    function employeeModal(employee={}) { const selected=new Set(employee.branches?.map(branch=>branch.id)||employee.branchIds||[]); openModal(employee.id?'Edit employee':'Add employee',`<form id="employeeForm"><div class="form-grid"><div class="full"><label>Name</label><input name="name" value="${esc(employee.name)}" required></div><div><label>User ID</label><input name="userId" value="${esc(employee.userId)}" ${employee.id?'disabled':''} required></div><div><label>Temporary password${employee.id?' (optional)':''}</label><input name="password" type="password" minlength="8" ${employee.id?'':'required'} placeholder="At least 8 characters"></div><div class="full"><label>Assigned branches</label><div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px">${state.branches.filter(branch=>branch.active).map(branch=>`<label style="margin:0;font-weight:500"><input type="checkbox" name="branchIds" value="${branch.id}" ${selected.has(branch.id)?'checked':''}> ${esc(branch.name)}</label>`).join('')}</div></div></div><div class="form-actions"><button type="button" class="secondary" data-action="close-modal">Cancel</button><button class="primary">${employee.id?'Save changes':'Create employee'}</button></div></form>`); $('employeeForm').onsubmit=async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));data.branchIds=[...e.target.querySelectorAll('[name="branchIds"]:checked')].map(input=>input.value);try{await api(employee.id?`/api/users/${employee.id}`:'/api/users',{method:employee.id?'PATCH':'POST',body:JSON.stringify(data)});$('modalRoot').innerHTML='';toast(employee.id?'Employee updated':'Employee added successfully.');await refresh();}catch(error){toast(error.message);}}; }
    function taskModal(task={}) { const employeeMode=state.user.role!=='admin'; openModal(task.id?'Edit task':'Assign task',`<form id="taskForm"><div class="form-grid"><div class="full"><label>Task title</label><input name="title" value="${esc(task.title)}" ${employeeMode?'disabled':''} required></div><div class="full"><label>Description</label><textarea name="description" ${employeeMode?'disabled':''}>${esc(task.description)}</textarea></div>${employeeMode?'':`<div><label>Employee</label><select name="employeeId" required>${state.users.filter(u=>u.active).map(u=>`<option value="${u.id}" ${u.id===task.employeeId?'selected':''}>${esc(u.name)}</option>`).join('')}</select></div><div><label>Branch</label><select name="branchId" required>${state.branches.filter(b=>b.active).map(b=>`<option value="${b.id}" ${b.id===task.branchId?'selected':''}>${esc(b.name)}</option>`).join('')}</select></div>`}<div><label>Priority</label><select name="priority" ${employeeMode?'disabled':''}>${PRIORITIES.map(priority=>`<option ${task.priority===priority?'selected':''}>${priority}</option>`).join('')}</select></div><div><label>Status</label><select name="status"><option ${!task.status||task.status==='Not Started'?'selected':''}>Not Started</option>${STATUSES.slice(1).map(status=>`<option ${task.status===status?'selected':''}>${status}</option>`).join('')}</select></div><div><label>Progress (0-100)</label><input name="progress" type="number" min="0" max="100" value="${task.progress||0}"></div><div><label>Due date</label><input name="dueDate" type="date" value="${task.dueDate||''}" ${employeeMode?'disabled':''} required></div><div class="full"><label>Remarks</label><textarea name="remarks" placeholder="Add a work update...">${esc(task.remarks)}</textarea></div></div><div class="form-actions"><button type="button" class="secondary" data-action="close-modal">Cancel</button><button class="primary">${task.id?'Save task':'Assign task'}</button></div></form>`); $('taskForm').onsubmit=async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));data.progress=Number(data.progress);try{await api(task.id?`/api/tasks/${task.id}`:'/api/tasks',{method:task.id?'PATCH':'POST',body:JSON.stringify(data)});$('modalRoot').innerHTML='';toast(task.id?'Task updated':'Task assigned successfully.');await refresh();}catch(error){toast(error.message);}}; }
    function toolbar() { return `<div class="toolbar"><input id="search" placeholder="Search employee, branch, task or remarks..." value="${esc(state.query)}"><select id="filterBranch"><option value="all">All branches</option>${state.branches.filter(branch=>branch.active).map(branch=>`<option value="${branch.id}">${esc(branch.name)}</option>`).join('')}</select><select id="filterStatus"><option value="all">All statuses</option>${['Not Started','In Progress','Completed','On Hold','Pending Review'].map(status=>`<option>${status}</option>`).join('')}</select><select id="filterPriority"><option value="all">All priorities</option>${PRIORITIES.map(priority=>`<option>${priority}</option>`).join('')}</select></div>`; }
    function renderOverview() { const s=stats(state.tasks); const progress=state.tasks.length?Math.round(state.tasks.reduce((sum,task)=>sum+Number(task.progress||0),0)/state.tasks.length):0; heading(`Good morning, ${state.user.name.split(' ')[0]}`,state.user.role==='admin'?'Here is what is happening across your workspace.':'Here is your task pulse for today.'); const cards=state.user.role==='admin'?[statCard('Total employees',s.employees,'♧'),statCard('Active employees',s.active,'●'),statCard('Total branches',state.branches.length,'⌖'),statCard('Total tasks',s.total,'✓'),statCard('Completed',s.completed,'●'),statCard('In progress',s.progress,'↗'),statCard('Pending',s.pending,'○','warn'),statCard('Overdue',s.overdue,'!','danger'),statCard('Overall progress',`${progress}%`,'↗')]:[statCard('Assigned tasks',s.total,'✓'),statCard('Completed',s.completed,'●'),statCard('In progress',s.progress,'↗'),statCard('Pending',s.pending,'○','warn'),statCard('Overdue',s.overdue,'!','danger'),statCard('Overall progress',`${progress}%`,'↗')]; const actions=state.user.role==='admin'?'<div class="section-head"><div><h2>Quick actions</h2><p>Keep the workspace current from one place.</p></div><div class="row-actions"><button class="primary" data-action="new-employee">＋ Add employee</button><button class="primary" data-action="new-branch">＋ Add branch</button><button class="primary" data-action="new-task">＋ Assign task</button></div></div>':''; $('content').innerHTML=`<div class="stats">${cards.join('')}</div>${actions}<div class="two-col"><section><div class="section-head"><div><h2>${state.user.role==='admin'?'Recent task activity':'My work'}</h2><p>${state.user.role==='admin'?'A live view of work across the team.':`Branches: ${state.user.branches.map(branch=>esc(branch.name)).join(', ')||'None assigned yet'}`}</p></div></div><div class="task-list">${taskCards(state.tasks.slice(0,5))}</div></section><section class="panel"><div class="section-head"><div><h2>Notifications</h2><p>Updates from your workspace</p></div></div><div class="notice-list">${notifications()}</div></section></div>`; }
    function renderBranches() { heading('Branch management','Monitor locations and the work attached to each one.'); $('content').innerHTML=`<div class="section-head"><div><h2>Branches</h2><p>${state.branches.length} branches in your workspace</p></div><button class="primary" data-action="new-branch">＋ Add branch</button></div><div class="table-wrap"><table><thead><tr><th>Branch</th><th>Tasks</th><th>Completed</th><th>Progress</th><th>Access</th><th></th></tr></thead><tbody>${state.branches.map(branch=>`<tr><td><strong>${esc(branch.name)}</strong></td><td>${branch.totalTasks}</td><td>${branch.completed}</td><td><strong>${branch.progress}%</strong><div style="height:5px;background:#e8eeee;border-radius:4px;margin-top:7px"><div style="width:${branch.progress}%;height:100%;background:var(--teal);border-radius:4px"></div></div></td><td><span class="badge ${branch.active?'status-completed':'status-overdue'}">${branch.active?'Active':'Inactive'}</span></td><td class="row-actions"><button class="small-btn" data-action="edit-branch" data-id="${branch.id}">Edit</button><button class="small-btn" data-action="toggle-branch" data-id="${branch.id}">${branch.active?'Deactivate':'Reactivate'}</button></td></tr>`).join('')}</tbody></table></div>`; }
    function filteredTasks() { const branchFilter=$('filterBranch')?.value||'all'; const responsibleFilter=$('filterResponsible')?.value||'all'; return state.tasks.filter(task=>(!state.query||`${task.title} ${task.description} ${task.remarks} ${task.assigneeName} ${task.responsibleEmployeeName} ${task.branchName}`.toLowerCase().includes(state.query.toLowerCase()))&&(branchFilter==='all'||task.branchId===branchFilter)&&(responsibleFilter==='all'||task.responsibleEmployeeId===responsibleFilter)&&(state.status==='all'||state.status===task.status)&&(state.priority==='all'||state.priority===task.priority)); }
    function render() { const admin=state.user.role==='admin'; document.querySelectorAll('.admin-only').forEach(el=>el.classList.toggle('hidden',!admin)); document.querySelectorAll('.employee-only').forEach(el=>el.classList.toggle('hidden',admin)); document.querySelectorAll('.nav-btn').forEach(el=>el.classList.toggle('active',el.dataset.page===state.page)); if(state.page==='employees'&&admin)renderEmployees(); else if(state.page==='branches'&&admin)renderBranches(); else if(state.page==='tasks'&&admin)renderTasks(); else if(state.page==='mytasks'&&!admin)renderMyTasks(); else renderOverview(); }
    function taskModal(task={}) { const employeeMode=state.user.role!=='admin'; const selected=new Set(task.assignedEmployees?.map(employee=>employee.id)||[task.employeeId].filter(Boolean)); const activeEmployees=state.users.filter(employee=>employee.active); const selectedMarkup=()=>[...document.querySelectorAll('#taskForm input[name="employeeIds"]:checked')].map(input=>`<span class="badge status-progress" style="margin:3px 3px 0 0">${esc(input.dataset.userId)} — ${esc(input.dataset.name)}</span>`).join('')||'<span style="color:var(--muted);font-size:12px">No employees selected</span>'; openModal(task.id?'Edit task':'Assign task',`<form id="taskForm"><div class="form-grid"><div class="full"><label>Task title</label><input name="title" value="${esc(task.title)}" ${employeeMode?'disabled':''} required></div><div class="full"><label>Description</label><textarea name="description" ${employeeMode?'disabled':''}>${esc(task.description)}</textarea></div>${employeeMode?'':`<div class="full"><label>Assign to employees</label><div style="display:flex;gap:8px;margin-bottom:8px"><button type="button" class="small-btn" data-action="select-all-employees">Select All</button><button type="button" class="small-btn" data-action="clear-all-employees">Clear All</button></div><div id="employeePicker" style="border:1px solid var(--line);border-radius:8px;padding:10px;max-height:150px;overflow:auto">${activeEmployees.map(employee=>`<label style="display:flex;gap:8px;align-items:center;margin:5px 0;font-weight:500"><input type="checkbox" name="employeeIds" value="${employee.id}" data-user-id="${esc(employee.userId)}" data-name="${esc(employee.name)}" ${selected.has(employee.id)?'checked':''}> <span>${esc(employee.userId)} — ${esc(employee.name)}</span></label>`).join('')}</div><div id="selectedEmployees" style="margin-top:8px">${[...selected].map(id=>{const employee=activeEmployees.find(item=>item.id===id);return employee?`<span class="badge status-progress" style="margin:3px 3px 0 0">${esc(employee.userId)} — ${esc(employee.name)}</span>`:''}).join('')||'<span style="color:var(--muted);font-size:12px">No employees selected</span>'}</div></div><div><label>Branch</label><select name="branchId" required>${state.branches.filter(branch=>branch.active).map(branch=>`<option value="${branch.id}" ${branch.id===task.branchId?'selected':''}>${esc(branch.name)}</option>`).join('')}</select></div>`}<div><label>Priority</label><select name="priority" ${employeeMode?'disabled':''}>${PRIORITIES.map(priority=>`<option ${task.priority===priority?'selected':''}>${priority}</option>`).join('')}</select></div><div><label>Status</label><select name="status">${STATUSES.map(status=>`<option ${task.status===status?'selected':''}>${status}</option>`).join('')}</select></div><div><label>Progress (0-100)</label><input name="progress" type="number" min="0" max="100" value="${task.progress||0}"></div><div><label>Due date</label><input name="dueDate" type="date" value="${task.dueDate||''}" ${employeeMode?'disabled':''} required></div><div class="full"><label>Remarks</label><textarea name="remarks" placeholder="Add a work update...">${esc(task.remarks)}</textarea></div></div><div class="form-actions"><button type="button" class="secondary" data-action="close-modal">Cancel</button><button class="primary">${task.id?'Save task':'Create & assign task'}</button></div></form>`); if(!employeeMode){document.querySelectorAll('#taskForm input[name="employeeIds"]').forEach(input=>input.addEventListener('change',()=>{$('selectedEmployees').innerHTML=selectedMarkup();}));} $('taskForm').onsubmit=async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));data.progress=Number(data.progress);if(!employeeMode)data.employeeIds=[...e.target.querySelectorAll('input[name="employeeIds"]:checked')].map(input=>input.value);try{await api(task.id?`/api/tasks/${task.id}`:'/api/tasks',{method:task.id?'PATCH':'POST',body:JSON.stringify(data)});$('modalRoot').innerHTML='';toast(task.id?'Task updated':'Task assigned successfully.');await refresh();}catch(error){toast(error.message);}}; }
    function taskCards(tasks) { if(!tasks.length)return '<div class="panel empty">No tasks to show yet.</div>'; return tasks.map(task=>{const assignees=task.assignedEmployees?.map(employee=>employee.userId).join(', ')||task.assigneeName;return `<article class="task-card"><div class="task-card-top"><div><h3>${esc(task.title)}</h3><p>${esc(task.description)||'No description added.'}</p></div><span class="badge ${statusClass(task.status)}">${esc(task.status)}</span></div><div class="task-meta"><span>${esc(task.branchName)} · Due ${formatDate(task.dueDate)}</span><span class="badge ${priorityClass(task.priority)}">${esc(task.priority)}</span><span title="Responsible employee">Responsible: ${esc(task.responsibleEmployeeName||task.assigneeName)}</span>${state.user.role==='admin'?`<span title="Assigned employees">Assigned: ${esc(assignees)}</span>`:''}<button class="small-btn" data-action="edit-task" data-id="${task.id}">View</button></div></article>`;}).join(''); }
    function renderTasks() { heading('Task management','Create, assign, and monitor every piece of work.'); $('content').innerHTML=`<div class="section-head"><div><h2>All tasks</h2><p>${state.tasks.length} individual assignments in this workspace</p></div><button class="primary" data-action="new-task">＋ Create task</button></div>${toolbar()}<div class="table-wrap"><table><thead><tr><th>Task</th><th>Assigned employees</th><th>Priority</th><th>Due date</th><th>Status</th><th></th></tr></thead><tbody>${filteredTasks().map(task=>`<tr><td><strong>${esc(task.title)}</strong><small style="display:block;color:#87949b;margin-top:4px">${esc(task.description).slice(0,55)}</small></td><td>${esc(task.assignedEmployees?.map(employee=>employee.userId).join(', ')||task.assigneeName)}</td><td><span class="badge ${priorityClass(task.priority)}">${esc(task.priority)}</span></td><td>${formatDate(task.dueDate)}</td><td><span class="badge ${isOverdue(task)?'status-overdue':statusClass(task.status)}">${isOverdue(task)?'Overdue':esc(task.status)}</span></td><td class="row-actions"><button class="small-btn" data-action="edit-task" data-id="${task.id}">Edit</button><button class="small-btn delete" data-action="delete-task" data-id="${task.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No matching tasks.</td></tr>'}</tbody></table></div>`; $('filterStatus').value=state.status; $('filterPriority').value=state.priority; }
    function performanceMarkup() { if (state.user.role !== 'admin') return ''; const performance=state.performance||{employees:[],summary:{totalTasks:0,completed:0,pending:0,inProgress:0,overdue:0,completionRate:0,progress:0}}; const summary=performance.summary; const rows=performance.employees; const maxCompleted=Math.max(1,...rows.map(row=>row.completed)); const maxRate=Math.max(1,...rows.map(row=>row.completionRate)); const total=summary.totalTasks||1; return `<section class="performance"><div class="section-head"><div><h2>Employee performance</h2><p>Live completion and workload metrics from current task data.</p></div></div><div class="summary-strip"><div class="summary-item"><strong>${summary.totalTasks}</strong><span>Total tasks</span></div><div class="summary-item"><strong>${summary.completed}</strong><span>Completed</span></div><div class="summary-item"><strong>${summary.completionRate}%</strong><span>Team completion</span></div><div class="summary-item"><strong>${summary.progress}%</strong><span>Overall progress</span></div></div><div class="performance-grid"><div class="chart-panel"><h3>Completed tasks by employee</h3><p>Actual completed task count</p><div class="bar-list">${rows.length?rows.map(row=>`<div class="bar-row"><span class="bar-label" title="${esc(row.employeeName)}">${esc(row.employeeName)}</span><div class="bar-track"><div class="bar-fill" style="width:${Math.round(row.completed/maxCompleted*100)}%"></div></div><span class="bar-value">${row.completed}</span></div>`).join(''):'<div class="empty-chart">No task data yet. Assign work to start tracking performance.</div>'}</div></div><div class="chart-panel"><h3>Team task status</h3><p>Pending, in progress, and completed work</p><div class="bar-list">${rows.length?rows.map(row=>`<div class="stack-row"><span class="bar-label" title="${esc(row.employeeName)}">${esc(row.employeeName)}</span><div class="stack"><span class="stack-pending" style="width:${row.pending/Math.max(1,row.total)*100}%"></span><span class="stack-progress" style="width:${row.inProgress/Math.max(1,row.total)*100}%"></span><span class="stack-completed" style="width:${row.completed/Math.max(1,row.total)*100}%"></span></div></div>`).join(''):'<div class="empty-chart">No employee task status data yet.</div>'}</div><div class="legend"><span><i class="stack-pending"></i>Pending</span><span><i class="stack-progress"></i>In progress</span><span><i class="stack-completed"></i>Completed</span></div></div><div class="chart-panel"><h3>Completion rate</h3><p>Completed tasks divided by assigned tasks</p><div class="rate-list">${rows.length?rows.map(row=>`<div class="rate-row"><span class="bar-label" title="${esc(row.employeeName)}">${esc(row.employeeName)}</span><div class="rate-track"><div class="rate-fill" style="width:${Math.round(row.completionRate/maxRate*100)}%"></div></div><span class="bar-value">${row.completionRate}%</span></div>`).join(''):'<div class="empty-chart">No employee completion data yet.</div>'}</div></div><div class="chart-panel"><h3>Workload snapshot</h3><p>Team-wide counts update after every task change</p><div class="bar-list"><div class="bar-row"><span class="bar-label">Pending</span><div class="bar-track"><div class="bar-fill" style="width:${summary.pending/total*100}%;background:#f6c55b"></div></div><span class="bar-value">${summary.pending}</span></div><div class="bar-row"><span class="bar-label">In progress</span><div class="bar-track"><div class="bar-fill" style="width:${summary.inProgress/total*100}%;background:#67a9d7"></div></div><span class="bar-value">${summary.inProgress}</span></div><div class="bar-row"><span class="bar-label">Overdue</span><div class="bar-track"><div class="bar-fill" style="width:${summary.overdue/total*100}%;background:#d85656"></div></div><span class="bar-value">${summary.overdue}</span></div></div></div></div></section>`; }
    function renderOverview() { const s=stats(state.tasks); const progress=state.performance?.summary?.progress ?? (state.tasks.length?Math.round(state.tasks.reduce((sum,task)=>sum+Number(task.progress||0),0)/state.tasks.length):0); heading(state.user.role==='admin'?'Good morning, Ankit Maheswari':`Good morning, ${state.user.name.split(' ')[0]}`,state.user.role==='admin'?'Here is what is happening across your workspace.':'Here is your task pulse for today.'); const cards=state.user.role==='admin'?[statCard('Total employees',s.employees,'♧'),statCard('Active employees',s.active,'●'),statCard('Total branches',state.branches.length,'⌖'),statCard('Total tasks',s.total,'✓'),statCard('Completed',s.completed,'●'),statCard('In progress',s.progress,'↗'),statCard('Pending',s.pending,'○','warn'),statCard('Overdue',s.overdue,'!','danger'),statCard('Overall progress',`${progress}%`,'↗')]:[statCard('Assigned tasks',s.total,'✓'),statCard('Completed',s.completed,'●'),statCard('In progress',s.progress,'↗'),statCard('Pending',s.pending,'○','warn'),statCard('Overdue',s.overdue,'!','danger'),statCard('Overall progress',`${progress}%`,'↗')]; const actions=state.user.role==='admin'?'<div class="section-head"><div><h2>Quick actions</h2><p>Keep the workspace current from one place.</p></div><div class="row-actions"><button class="primary" data-action="new-employee">＋ Add employee</button><button class="primary" data-action="new-branch">＋ Add branch</button><button class="primary" data-action="new-task">＋ Assign task</button></div></div>':''; $('content').innerHTML=`<div class="stats">${cards.join('')}</div>${actions}<div class="two-col"><section><div class="section-head"><div><h2>${state.user.role==='admin'?'Recent task activity':'My work'}</h2><p>${state.user.role==='admin'?'A live view of work across the team.':`Branches: ${state.user.branches.map(branch=>esc(branch.name)).join(', ')||'None assigned yet'}`}</p></div></div><div class="task-list">${taskCards(state.tasks.slice(0,5))}</div></section><section class="panel"><div class="section-head"><div><h2>Notifications</h2><p>Updates from your workspace</p></div></div><div class="notice-list">${notifications()}</div></section></div>${performanceMarkup()}`; }
    document.addEventListener('click',async e=>{const action=e.target.closest('[data-action]')?.dataset.action;if(!action)return;if(action==='close-modal')$('modalRoot').innerHTML='';if(action==='new-task')taskModal();if(action==='new-employee')employeeModal();if(action==='new-branch')branchModal();if(action==='edit-task')taskModal(state.tasks.find(t=>t.id===e.target.closest('[data-action]').dataset.id));if(action==='edit-employee')employeeModal(state.users.find(u=>u.id===e.target.closest('[data-action]').dataset.id));if(action==='edit-branch')branchModal(state.branches.find(b=>b.id===e.target.closest('[data-action]').dataset.id));if(action==='toggle-employee'){const employee=state.users.find(item=>item.id===e.target.closest('[data-action]').dataset.id);if(confirm(`${employee.active?'Deactivate':'Reactivate'} ${employee.name}? Previous task history will be retained.`)){await api(`/api/users/${employee.id}`,{method:'PATCH',body:JSON.stringify({active:!employee.active})});toast('Employee access updated');refresh();}}if(action==='toggle-branch'){const branch=state.branches.find(item=>item.id===e.target.closest('[data-action]').dataset.id);if(confirm(`${branch.active?'Deactivate':'Reactivate'} ${branch.name}?`)){await api(`/api/branches/${branch.id}`,{method:'PATCH',body:JSON.stringify({active:!branch.active})});toast('Branch access updated');refresh();}}if(action==='delete-task'&&confirm('Delete this task permanently?')){await api(`/api/tasks/${e.target.closest('[data-action]').dataset.id}`,{method:'DELETE'});toast('Task deleted');refresh();}});
    document.addEventListener('click',e=>{const action=e.target.closest('[data-action]')?.dataset.action;if(action==='select-all-employees'||action==='clear-all-employees'){document.querySelectorAll('#taskForm input[name="employeeIds"]').forEach(input=>input.checked=action==='select-all-employees');document.querySelectorAll('#taskForm input[name="employeeIds"]')[0]?.dispatchEvent(new Event('change'));}});
    document.addEventListener('click',e=>{const nav=e.target.closest('.nav-btn');if(nav){state.page=nav.dataset.page;state.query='';render();$('sidebar').classList.remove('open');}}); $('menuBtn').onclick=()=>$('sidebar').classList.toggle('open'); $('accountBtn').onclick=passwordModal; $('notificationBtn').onclick=()=>{state.notifications.forEach(n=>{if(!n.read)api(`/api/notifications/${n.id}/read`,{method:'POST'});});state.notifications.forEach(n=>n.read=true);$('notificationDot').classList.add('hidden');render();}; $('logoutBtn').onclick=async()=>{await api('/api/logout',{method:'POST'});location.reload();};
    document.addEventListener('input',e=>{if(e.target.id==='search'){state.query=e.target.value;render();} }); document.addEventListener('change',async e=>{if(e.target.id==='filterBranch'||e.target.id==='filterStatus'||e.target.id==='filterPriority'){if(e.target.id==='filterStatus')state.status=e.target.value;if(e.target.id==='filterPriority')state.priority=e.target.value;render();}if(e.target.closest('#taskForm')&&e.target.name==='status'&&state.user?.role==='admin'){const form=e.target.closest('#taskForm');const title=form.querySelector('[name="title"]')?.value;const branchId=form.querySelector('[name="branchId"]')?.value;const task=state.tasks.find(item=>item.title===title&&(!branchId||item.branchId===branchId));if(task){const previous=e.target.dataset.savedStatus||task.status;e.target.dataset.savedStatus=e.target.value;try{await api(`/api/tasks/${task.id}/status`,{method:'POST',body:JSON.stringify({status:e.target.value})});toast('Task status saved');}catch(error){e.target.value=previous;e.target.dataset.savedStatus=previous;toast(`Status could not be saved: ${error.message}`);}}}});
    function overviewDetail(metric) { if (state.user.role !== 'admin') return; const titles={employees:'All employees',activeEmployees:'Active employees',branches:'Branches',tasks:'All task assignments',pending:'Pending task assignments',inProgress:'In-progress task assignments',completed:'Completed task assignments',overdue:'Overdue task assignments',progress:'Team progress'}; const taskMetric=['tasks','pending','inProgress','completed','overdue'].includes(metric); const matches=task=>metric==='tasks'||(metric==='pending'&&['Not Started','Pending','Pending Review','On Hold'].includes(task.status))||(metric==='inProgress'&&task.status==='In Progress')||(metric==='completed'&&task.status==='Completed')||(metric==='overdue'&&isOverdue(task)); const employees=metric==='activeEmployees'?state.users.filter(user=>user.active):state.users; const tasks=state.tasks.filter(matches); const taskTable=items=>items.length?`<div class="modal-table"><table><thead><tr><th>Task</th><th>Employee(s)</th><th>Priority</th><th>Due date</th><th>Status</th><th>Completed</th></tr></thead><tbody>${items.map(task=>`<tr><td><strong>${esc(task.title)}</strong><small style="display:block;color:#87949b;margin-top:4px">${esc(task.description||'No description')}</small></td><td>${esc(task.assignedEmployees?.map(employee=>employee.userId).join(', ')||task.assigneeName)}</td><td><span class="badge ${priorityClass(task.priority)}">${esc(task.priority)}</span></td><td>${formatDate(task.dueDate)}</td><td><span class="badge ${isOverdue(task)?'status-overdue':statusClass(task.status)}">${isOverdue(task)?'Overdue':esc(task.status)}</span></td><td>${task.completedAt?formatTime(task.completedAt):'—'}</td></tr>`).join('')}</tbody></table></div>`:'<div class="detail-empty">No matching database records.</div>'; const employeeTable=items=>items.length?`<div class="modal-table"><table><thead><tr><th>Employee ID</th><th>Name</th><th>Role</th><th>Status</th><th>Assigned tasks</th></tr></thead><tbody>${items.map(employee=>`<tr><td><strong>${esc(employee.userId)}</strong></td><td>${esc(employee.name)}</td><td>${esc(employee.role)}</td><td><span class="badge ${employee.active?'status-completed':'status-overdue'}">${employee.active?'Active':'Inactive'}</span></td><td>${state.tasks.filter(task=>task.assigneeId===employee.id).length}</td></tr>`).join('')}</tbody></table></div>`:'<div class="detail-empty">No matching employees.</div>'; const summary=state.performance?.summary||{totalTasks:0,completed:0,progress:0,completionRate:0}; const body=`<p style="color:var(--muted);margin-top:0">Live data from the latest dashboard refresh.</p>${taskMetric?`<div class="toolbar"><input id="overviewDetailSearch" placeholder="Search task, employee, branch or priority..."></div><div id="overviewDetailResults">${taskTable(tasks)}</div>`:metric==='employees'||metric==='activeEmployees'?`<div class="toolbar"><input id="overviewDetailSearch" placeholder="Search employee name or ID..."></div><div id="overviewDetailResults">${employeeTable(employees)}</div>`:metric==='branches'?`<div class="modal-table"><table><thead><tr><th>Branch</th><th>Status</th><th>Tasks</th><th>Progress</th></tr></thead><tbody>${state.branches.map(branch=>`<tr><td>${esc(branch.name)}</td><td><span class="badge ${branch.active?'status-completed':'status-overdue'}">${branch.active?'Active':'Inactive'}</span></td><td>${branch.totalTasks}</td><td>${branch.progress}%</td></tr>`).join('')}</tbody></table></div>`:`<div class="summary-strip"><div class="summary-item"><strong>${summary.totalTasks}</strong><span>Total assignments</span></div><div class="summary-item"><strong>${summary.completed}</strong><span>Completed</span></div><div class="summary-item"><strong>${summary.progress}%</strong><span>Overall progress</span></div><div class="summary-item"><strong>${summary.completionRate}%</strong><span>Completion rate</span></div></div>`}`; openModal(titles[metric]||'Overview details',body); const search=$('overviewDetailSearch'); if(search)search.addEventListener('input',()=>{const query=search.value.toLowerCase();if(taskMetric)$('overviewDetailResults').innerHTML=taskTable(tasks.filter(task=>`${task.title} ${task.assigneeName} ${task.branchName} ${task.priority}`.toLowerCase().includes(query)));else $('overviewDetailResults').innerHTML=employeeTable(employees.filter(employee=>`${employee.name} ${employee.userId}`.toLowerCase().includes(query)));}); }
    function renderOverviewInteractive() { const s=stats(state.tasks); const progress=state.performance?.summary?.progress ?? 0; heading(state.user.role==='admin'?'Good morning, Ankit Maheswari':`Good morning, ${state.user.name.split(' ')[0]}`,state.user.role==='admin'?'Here is what is happening across your workspace.':'Here is your task pulse for today.'); const cards=state.user.role==='admin'?[statCard('Total employees',s.employees,'♧'),statCard('Active employees',s.active,'●'),statCard('Total branches',state.branches.length,'⌖'),statCard('Total tasks',s.total,'✓'),statCard('Completed',s.completed,'●'),statCard('In progress',s.progress,'↗'),statCard('Pending',s.pending,'○','warn'),statCard('Overdue',s.overdue,'!','danger'),statCard('Overall progress',`${progress}%`,'↗')]:[statCard('Assigned tasks',s.total,'✓'),statCard('Completed',s.completed,'●'),statCard('In progress',s.progress,'↗'),statCard('Pending',s.pending,'○','warn'),statCard('Overdue',s.overdue,'!','danger'),statCard('Overall progress',`${progress}%`,'↗')]; const actions=state.user.role==='admin'?'<div class="section-head"><div><h2>Quick actions</h2><p>Keep the workspace current from one place.</p></div><div class="row-actions"><button class="primary" data-action="new-employee">＋ Add employee</button><button class="primary" data-action="new-branch">＋ Add branch</button><button class="primary" data-action="new-task">＋ Assign task</button></div></div>':''; $('content').innerHTML=`<div class="stats">${cards.join('')}</div>${actions}<div class="two-col"><section><div class="section-head"><div><h2>${state.user.role==='admin'?'Recent task activity':'My work'}</h2><p>${state.user.role==='admin'?'A live view of work across the team.':`Branches: ${state.user.branches.map(branch=>esc(branch.name)).join(', ')||'None assigned yet'}`}</p></div></div><div class="task-list">${taskCards(state.tasks.slice(0,5))}</div></section><section class="panel"><div class="section-head"><div><h2>Notifications</h2><p>Updates from your workspace</p></div></div><div class="notice-list">${notifications()}</div></section></div>${performanceMarkup()}`; }
    function render() { const admin=state.user.role==='admin'; document.querySelectorAll('.admin-only').forEach(el=>el.classList.toggle('hidden',!admin)); document.querySelectorAll('.employee-only').forEach(el=>el.classList.toggle('hidden',admin)); document.querySelectorAll('.nav-btn').forEach(el=>el.classList.toggle('active',el.dataset.page===state.page)); if(state.page==='employees'&&admin)renderEmployees(); else if(state.page==='branches'&&admin)renderBranches(); else if(state.page==='tasks'&&admin)renderTasks(); else if(state.page==='mytasks'&&!admin)renderMyTasks(); else renderOverviewInteractive(); }
    document.addEventListener('click',e=>{const action=e.target.closest('[data-action]')?.dataset.action;if(action==='overview-detail')overviewDetail(e.target.closest('[data-action]').dataset.metric);});
    function overviewGreeting() { const hour=new Date().getHours(); return hour<12?'Good morning':hour<18?'Good afternoon':'Good evening'; }
    function overviewActivity() { const events=(state.history||[]).slice(0,6); if(!events.length)return '<div class="empty">No recent activity recorded yet.</div>'; return `<div class="activity-list">${events.map(event=>`<div class="activity-item"><div class="activity-icon">${event.action.toLowerCase().includes('complete')?'✓':event.action.toLowerCase().includes('delete')?'×':'↗'}</div><div><strong>${esc(event.action)}</strong><p>${esc(event.taskTitle||'Task')} · ${esc(event.changedByName||'Workspace user')}</p></div><time>${new Date(event.timestamp).toLocaleString(undefined,{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'})}</time></div>`).join('')}</div>`; }
    function recentEmployees() { const users=state.users.slice().sort((a,b)=>new Date(b.updatedAt||b.createdAt)-new Date(a.updatedAt||a.createdAt)).slice(0,5); if(!users.length)return '<div class="empty">No employee activity yet.</div>'; return `<div class="activity-list">${users.map(user=>`<div class="activity-item"><div class="avatar">${initials(user.name)}</div><div><strong>${esc(user.name)}</strong><p>${user.active?'Active workspace member':'Inactive account'} · ${state.tasks.filter(task=>task.assigneeId===user.id).length} assignments</p></div><time>${formatTime((user.updatedAt||user.createdAt).slice(0,10))}</time></div>`).join('')}</div>`; }
    function renderOverviewInteractive() { const s=stats(state.tasks); const performance=state.performance?.summary||{progress:0}; const admin=state.user.role==='admin'; const cards=admin?[statCard('Total employees',s.employees,'♧'),statCard('Active employees',s.active,'●'),statCard('Total tasks',s.total,'✓'),statCard('Pending',s.pending,'○','warn'),statCard('In progress',s.progress,'↗'),statCard('Completed',s.completed,'●'),statCard('Overdue',s.overdue,'!','danger')]:[statCard('Assigned tasks',s.total,'✓'),statCard('Pending',s.pending,'○','warn'),statCard('In progress',s.progress,'↗'),statCard('Completed',s.completed,'●'),statCard('Overdue',s.overdue,'!','danger')]; const actions=admin?'<div class="section-head"><div><h2>Quick actions</h2><p>Keep the workspace current from one place.</p></div><div class="row-actions"><button class="primary" data-action="new-employee">＋ Add employee</button><button class="primary" data-action="new-branch">＋ Add branch</button><button class="primary" data-action="new-task">＋ Assign task</button></div></div>':''; $('content').innerHTML=`<section class="overview-hero"><div><div class="overview-kicker">Workspace overview</div><h1>${overviewGreeting()}, ${admin?'Ankit Maheswari':esc(state.user.name)}</h1><p>${admin?"Here’s your team’s performance overview.":'Here is your personal task overview.'}</p></div><div class="overview-date"><div><strong>${admin?'Admin workspace':'Employee workspace'}</strong><span>${new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric',year:'numeric'})}</span></div><div class="avatar">${initials(admin?'Ankit Maheswari':state.user.name)}</div></div></section><section class="overview-section"><div class="section-head"><div><h2>At a glance</h2><p>Click any metric to inspect the live records behind it.</p></div></div><div class="stats">${cards.join('')}</div></section>${actions}<section class="overview-section"><div class="section-head"><div><h2>Performance analytics</h2><p>Live workload and completion signals from your database.</p></div></div>${admin?`<div class="overview-analytics">${performanceMarkup()}</div>`:'<div class="panel"><div class="summary-strip"><div class="summary-item"><strong>${performance.totalTasks||0}</strong><span>Assigned tasks</span></div><div class="summary-item"><strong>${performance.completed||0}</strong><span>Completed</span></div><div class="summary-item"><strong>${performance.progress||0}%</strong><span>Progress</span></div><div class="summary-item"><strong>${performance.completionRate||0}%</strong><span>Completion rate</span></div></div></div>'}</section><section class="activity-panel"><div class="panel"><div class="section-head"><div><h2>Recent activity</h2><p>Latest recorded workspace changes</p></div></div>${admin?overviewActivity():'<div class="empty">Your recent task updates will appear here.</div>'}</div><div class="panel"><div class="section-head"><div><h2>Employee activity</h2><p>Current team presence and workload</p></div></div>${admin?recentEmployees():'<div class="empty">Personal activity is available in My Tasks.</div>'}</div></section>`; }
    async function refresh() { $('content').innerHTML='<div class="panel loading-panel"><div><span class="loading-dot"></span>Loading workspace data...</div></div>'; try { const data=await api('/api/dashboard'); Object.assign(state,data); $('userName').textContent=state.user.name; $('userRole').textContent=state.user.role==='admin'?'Admin / Manager':'Employee'; $('userAvatar').textContent=initials(state.user.name); $('notificationDot').classList.toggle('hidden',!state.notifications.some(n=>!n.read)); render(); } catch(error) { $('content').innerHTML=`<div class="panel empty"><strong>Unable to load dashboard</strong><p>${esc(error.message)}</p><button class="primary" onclick="refresh()">Try again</button></div>`; } }
    $('loginForm').onsubmit=async e=>{e.preventDefault();$('loginError').textContent='';try{await api('/api/login',{method:'POST',body:JSON.stringify({userId:$('loginId').value,password:$('loginPassword').value})});showApp();await refresh();}catch(error){$('loginError').textContent=error.message;}};
    function taskCards(tasks) { if(!tasks.length)return '<div class="panel empty">No tasks to show yet.</div>'; return tasks.map(task=>{const assignees=task.assignedEmployees?.map(employee=>employee.userId).join(', ')||task.assigneeName;return `<article class="task-card"><div class="task-card-top"><div><h3>${esc(task.title)}</h3><p>${esc(task.description)||'No description added.'}</p></div><span class="badge ${statusClass(task.status)}">${esc(task.status)}</span></div><div class="task-meta"><span>${esc(task.branchName)} · Due ${formatDate(task.dueDate)}</span><span class="badge ${priorityClass(task.priority)}">${esc(task.priority)}</span><span title="Responsible employee">Responsible: ${esc(task.responsibleEmployeeName||task.assigneeName)}</span>${state.user.role==='admin'?`<span title="Other assigned employees">Assigned: ${esc(assignees)}</span>`:''}<button class="small-btn" data-action="edit-task" data-id="${task.id}">View</button></div></article>`;}).join(''); }
    (async()=>{try{await api('/api/session');showApp();await refresh();}catch{}})();
  </script>
</body>
</html>